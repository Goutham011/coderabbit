{
  "name": "coderabbit-vscode",
  "displayName": "Agentic Code Review",
  "description": "AI-powered code review for VS Code. Real-time inline annotations and PR review integration.",
  "version": "0.1.0",
  "publisher": "coderabbit",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:coderabbit.reviewFile",
    "onCommand:coderabbit.reviewWorkspace",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coderabbit.reviewFile",
        "title": "Agentic: Review Current File",
        "category": "Agentic"
      },
      {
        "command": "coderabbit.reviewWorkspace",
        "title": "Agentic: Review Workspace",
        "category": "Agentic"
      },
      {
        "command": "coderabbit.reviewSaved",
        "title": "Agentic: Review Last Save",
        "category": "Agentic"
      },
      {
        "command": "coderabbit.openPanel",
        "title": "Agentic: Open Review Panel",
        "category": "Agentic"
      }
    ],
    "keybindings": [
      {
        "command": "coderabbit.reviewFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "win": "ctrl+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "coderabbit.openPanel",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "win": "ctrl+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "problemMatchers": [
      {
        "name": "coderabbit",
        "owner": "coderabbit",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\\\d+):(\\\\d+):\\\\s+(\\\\w+):\\\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "coderabbitReviewPanel",
          "name": "Agentic Review"
        }
      ]
    },
    "configuration": {
      "title": "Agentic Settings",
      "properties": {
        "coderabbit.enableOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run code review on file save"
        },
        "coderabbit.autoApplyFixes": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply one-click fixes"
        },
        "coderabbit.severityThreshold": {
          "type": "string",
          "default": "medium",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Minimum severity to display"
        },
        "coderabbit.skipGeneratedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip generated and vendor files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts,.js",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.0.0",
    "@types/mocha": "^10.0.0",
    "@vscode/test-electron": "^2.4.0",
    "typescript": "^5.2.0",
    "mocha": "^10.2.0",
    "eslint": "^8.45.0",
    "eslint-plugin-n": "^16.0.0",
    "@vscode/vsce": "^3.0.0"
  },
  "overrides": {
    "serialize-javascript": "^6.0.2",
    "glob": "^10.4.5",
    "minimatch": "^10.0.1"
  }
}